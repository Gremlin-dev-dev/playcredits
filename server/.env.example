# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=4000
# Example: postgres://postgres:YOUR_PASSWORD@localhost:5432/playcredits
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/playcredits
# Supabase: use the "Session pooler" string (Connect button), and set DATABASE_SSL=true.
# (Do not use the Transaction pooler: migrations use an advisory lock that needs a session.)
DATABASE_SSL=false
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
# Exact browser origin of the frontend (used for CORS and Origin checks)
CLIENT_ORIGIN=http://localhost:5173
WELCOME_BONUS_CREDITS=10000
MIN_BET_CREDITS=100
MAX_BET_CREDITS=5000
# Set to 1 when running behind a reverse proxy (so rate limiting sees real IPs)
TRUST_PROXY=0
# Used only by "npm test" (integration tests). Use a SEPARATE database.
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/playcredits_test
